input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
        natural-scroll
    }
}

layout {
    gaps 16
    struts {
        left 12
        right 12
        top 12
        bottom 12
    }
    focus-ring {
        // Убрали строку enable true
        width 2
        active-color "#a020f0"
    }
}





window-rule {
    match app-id="com.mitchellh.ghostty"
    opacity 0.9
    draw-border-with-background false
}




binds {
    Mod+T { spawn "ghostty"; }
    Mod+Q { close-window; }
    
    // Вместо reload-config в новых версиях используется:
    Mod+Shift+R { spawn "niri" "msg" "action" "reload-config"; }
    Mod+Alt+L {spawn "swaylock"; }
    Print { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy"; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }

}






