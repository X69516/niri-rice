{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/lain.txt",
    "color": {
      "1": "magenta",
      "2": "magenta"
    }
  },
  "display": {
    "separator": " ",
    "color": "magenta"
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "magenta"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "󰏖 Pacman",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "battery",
      "key": "󰁹 Battery",
      "keyColor": "magenta"
    },
    {
      "type": "swap",
      "key": "󰓡 Swap",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk (/)",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "󱆃 Terminal",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "󰞀 Shell",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "terminalfont",
      "key": "󰛖 Font",
      "keyColor": "magenta"
    }
  ]
}
